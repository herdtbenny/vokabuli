# Umgebungsvariablen für Vokabuli (echte Werte liegen bei Vercel – lokal holen mit `vercel env pull`)

# Neon-Datenbank (wird über den Vercel-Marketplace automatisch gesetzt)
DATABASE_URL=

# Signiert das Geräte-Cookie nach dem Login – langer Zufallswert, z.B. `openssl rand -base64 48`
SESSION_SECRET=

# Familien-Passwort, das jedes Gerät einmal eingibt.
# Für die lokale Entwicklung ist bei Vercel (Environment "Development") der Testwert "vokabuli-dev" hinterlegt.
# Für Production selbst festlegen: `vercel env add APP_PASSWORD production`
APP_PASSWORD=
